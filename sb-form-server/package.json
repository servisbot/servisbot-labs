{
  "name": "sb-form-server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "mount-dev": "ln -s test/fixtures/templates sb-form-templates",
    "start": "node index.js",
    "dev-mount": "npm run mount-dev && NODE_ENV=development nodemon -r dotenv/config index.js",
    "dev": "NODE_ENV=development nodemon -r dotenv/config index.js",
    "lint": "./node_modules/.bin/eslint src test",
    "test": "node_modules/.bin/mocha --recursive test",
    "depcheck": "./node_modules/.bin/depcheck --ignores pre-commit,pug,dotenv ."
  },
  "dependencies": {
    "canvas": "^2.6.1",
    "debug": "~4.4.3",
    "express": "~5.2.1",
    "http-errors": "~1.7.3",
    "jsdom": "^16.7.0",
    "juice": "^12.1.1",
    "morgan": "~1.11.0",
    "nodemailer": "^9.0.1",
    "pre-commit": "^2.0.0",
    "pug": "^3.0.4"
  },
  "pre-commit": [
    "test",
    "lint",
    "depcheck"
  ],
  "devDependencies": {
    "dotenv": "^8.2.0",
    "depcheck": "^0.9.2",
    "eslint": "^10.7.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.13.0",
    "eslint-plugin-mocha": "^5.1.0",
    "mocha": "^7.1.0"
  }
}
